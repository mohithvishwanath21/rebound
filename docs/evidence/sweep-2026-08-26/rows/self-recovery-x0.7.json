    "perturbation": {
      "id": "self-recovery-x0.7",
      "family": "world",
      "label": "self-recovery propensity -30%",
      "refit": true,
      "why": "Its own `basis` field says it is load-bearing for B0: set it high and every policy looks less impressive because much of the recovered money was never lost. Lowering it FLATTERS every active arm, which is why the +30% row matters more than this one."
    },
