# Copy to .env and fill in. NEVER commit .env.

# ---- Mongo ----
MONGO_URI=mongodb://127.0.0.1:27017/rebound

# ---- Razorpay TEST MODE ONLY ----
# Get these from Razorpay Dashboard -> Settings -> API Keys, in TEST mode.
# Test keys begin with rzp_test_. If you ever see rzp_live_ here, stop.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=some_secret_you_choose_in_the_dashboard

# Execution mode: SIM (mock adapter, used for batch evaluation)
#              or LIVE_TEST (real Razorpay test-mode API calls)
EXECUTION_MODE=SIM

# ---- LLM (diagnosis long tail + message drafting) ----
LLM_API_KEY=
LLM_MODEL=

# ---- Safety ----
# Hard ceiling on outbound messages per batch run. Belt and braces.
MAX_MESSAGES_PER_RUN=250
KILL_SWITCH=false
